# MongoDB container settings (Option B only). On the server: cp deploy/mongo.env.example deploy/mongo.env && chmod 600 deploy/mongo.env
# Use hex passwords (openssl rand -hex 24): they never need escaping inside a connection string.
# These are read only on the FIRST start (empty mongo-data volume); changing them later changes nothing.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=<openssl rand -hex 24>
# the app's own user (deploy/mongo-init.js): the same value as inside DB= in deploy/api.env
ZIT_APP_PASSWORD=<openssl rand -hex 24>
