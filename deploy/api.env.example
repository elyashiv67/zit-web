# API settings for production. On the server: cp deploy/api.env.example deploy/api.env && chmod 600 deploy/api.env
# Replace every <...>. deploy/api.env is gitignored: never commit it.
NODE_ENV=production
PORT=4586

# Option B (Mongo container): only the password changes, the same value as ZIT_APP_PASSWORD in deploy/mongo.env.
# Option A (Atlas): the connection string of an Atlas user with readWrite on Zit only.
DB=mongodb://zit_app:<ZIT_APP_PASSWORD>@mongo:27017/Zit?authSource=Zit

# NEW value, never the development one: openssl rand -base64 48
SESSION_SECRET=<48+ random characters>

# COPY the existing value from server/.env on your PC. A new value makes every stored DVR password unreadable.
# Keep a copy offline too (a password manager), separate from the backups.
DVR_SECRET=<existing value>

# nginx is the one proxy in front of the API
TRUST_PROXY=1
# the "uploads" volume (pin photos)
UPLOADS_DIR=/data/uploads

# COOKIE_SECURE is on by default in production. JWT_SECRET is no longer used.
