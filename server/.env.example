# copy to .env and fill in. The server checks these at startup (config/env.js).

# development | production | test
NODE_ENV=development
HOST=localhost
PORT=4586

# MongoDB connection string (Atlas or e.g. mongodb://mongo:27017/Zit in Docker)
DB=
# optional: use this database name instead of the one in DB
# DB_NAME=

# at least 32 random characters (required in production), e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# key for DVR passwords stored in the DB — at least 32 random characters, generate like above.
# Back it up: if it's lost, the stored DVR passwords can't be read
DVR_SECRET=

# HTTPS-only cookies — defaults to true in production. Set false only if production runs on plain http
# COOKIE_SECURE=true

# number of proxies in front of the server (nginx / Docker = 1), so rate limits see the real IP
TRUST_PROXY=0

# where pin images are stored (default: server/uploads). In Docker, mount this as a volume
# UPLOADS_DIR=

# npm test: database name for the test run (must contain "test"; dropped before and after)
# TEST_DB_NAME=zit_test
